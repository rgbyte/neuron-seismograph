# Byte-compiled / cache files (in root and any nested subfolder)
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment variables & credentials
.env
.env.*
*.pem
*.key
*.log

# OS / Editor files
.DS_Store
.idea/
.vscode/
*.swp
